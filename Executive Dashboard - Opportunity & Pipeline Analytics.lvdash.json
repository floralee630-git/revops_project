{
  "datasets": [
    {
      "name": "442d93f7",
      "displayName": "Opportunity by Stage",
      "queryLines": [
        "SELECT\n",
        "  deal_stage,\n",
        "  COUNT(*) AS opportunity_count,\n",
        "  CASE deal_stage\n",
        "    WHEN 'Lost' THEN 1\n",
        "    WHEN 'Prospecting' THEN 2\n",
        "    WHEN 'Engaging' THEN 3\n",
        "    WHEN 'Won' THEN 4\n",
        "    ELSE 5\n",
        "  END AS stage_order\n",
        "FROM\n",
        "  flora_workspace.default.sales_pipeline\n",
        "GROUP BY\n",
        "  deal_stage\n",
        "ORDER BY\n",
        "  stage_order"
      ]
    },
    {
      "name": "3dca892d",
      "displayName": "Pipeline by sales rep",
      "queryLines": [
        "SELECT\n",
        "    sales_agent,\n",
        "    COUNT(*) AS opportunity_count,\n",
        "    SUM(close_value) AS amount\n",
        "FROM flora_workspace.default.sales_pipeline\n",
        "GROUP BY sales_agent\n",
        "ORDER BY amount DESC;"
      ]
    },
    {
      "name": "8174ade4",
      "displayName": "Pipeline by product and stage",
      "queryLines": [
        "SELECT\n",
        "  product,\n",
        "  deal_stage,\n",
        "  COUNT(*) AS opportunity_count,\n",
        "  SUM(close_value) AS amount\n",
        "FROM\n",
        "  flora_workspace.default.sales_pipeline\n",
        "GROUP BY\n",
        "  product,\n",
        "  deal_stage\n",
        "ORDER BY\n",
        "  product,\n",
        "  deal_stage"
      ]
    },
    {
      "name": "bb1b4e33",
      "displayName": "Open Opportunity Concentration by Rep",
      "queryLines": [
        "WITH account_opportunities AS (\n",
        "  SELECT\n",
        "    account,\n",
        "    COUNT(*) AS open_opportunity_count\n",
        "  FROM\n",
        "    flora_workspace.default.sales_pipeline\n",
        "  WHERE\n",
        "    deal_stage NOT IN ('Won', 'Lost')\n",
        "    AND account IS NOT NULL\n",
        "  GROUP BY\n",
        "    account\n",
        "),\n",
        "ranked AS (\n",
        "  SELECT\n",
        "    account,\n",
        "    open_opportunity_count,\n",
        "    ROW_NUMBER() OVER (ORDER BY open_opportunity_count DESC, account ASC) AS opportunity_rank\n",
        "  FROM\n",
        "    account_opportunities\n",
        "),\n",
        "grouped AS (\n",
        "  SELECT\n",
        "    CASE\n",
        "      WHEN opportunity_rank <= 9 THEN account\n",
        "      ELSE 'Other'\n",
        "    END AS account,\n",
        "    SUM(open_opportunity_count) AS open_opportunity_count\n",
        "  FROM\n",
        "    ranked\n",
        "  GROUP BY\n",
        "    CASE\n",
        "      WHEN opportunity_rank <= 9 THEN account\n",
        "      ELSE 'Other'\n",
        "    END\n",
        ")\n",
        "SELECT\n",
        "  account,\n",
        "  open_opportunity_count,\n",
        "  open_opportunity_count * 1.0 / SUM(open_opportunity_count) OVER () AS share_pct\n",
        "FROM\n",
        "  grouped\n",
        "ORDER BY\n",
        "  CASE\n",
        "    WHEN account = 'Other' THEN 999\n",
        "    ELSE open_opportunity_count\n",
        "  END DESC"
      ]
    },
    {
      "name": "b3ca54bb",
      "displayName": "Average Sales Cycle by Rep",
      "queryLines": [
        "SELECT\n",
        "    sales_agent,\n",
        "\n",
        "    COUNT(*) AS won_opportunities,\n",
        "\n",
        "    ROUND(\n",
        "        AVG(\n",
        "            DATEDIFF(close_date, engage_date)\n",
        "        ),\n",
        "        1\n",
        "    ) AS avg_sales_cycle_days\n",
        "\n",
        "FROM flora_workspace.default.sales_pipeline\n",
        "\n",
        "WHERE deal_stage = 'Won'\n",
        "  AND engage_date IS NOT NULL\n",
        "  AND close_date IS NOT NULL\n",
        "\n",
        "GROUP BY sales_agent\n",
        "\n",
        "ORDER BY avg_sales_cycle_days DESC;"
      ]
    },
    {
      "name": "5ba09f85",
      "displayName": "Open Opportunity Concentration by Rep",
      "queryLines": [
        "WITH rep_opportunities AS (\n",
        "    SELECT\n",
        "        sales_agent,\n",
        "        COUNT(*) AS open_opportunity_count\n",
        "    FROM flora_workspace.default.sales_pipeline\n",
        "    WHERE deal_stage NOT IN ('Won', 'Lost')\n",
        "      AND sales_agent IS NOT NULL\n",
        "    GROUP BY sales_agent\n",
        "),\n",
        "\n",
        "total_open AS (\n",
        "    SELECT\n",
        "        SUM(open_opportunity_count) AS total_open_opportunities\n",
        "    FROM rep_opportunities\n",
        ")\n",
        "\n",
        "SELECT\n",
        "    sales_agent,\n",
        "    open_opportunity_count,\n",
        "\n",
        "    CONCAT(\n",
        "        ROUND(\n",
        "            100.0 * open_opportunity_count / total_open_opportunities,\n",
        "            2\n",
        "        ),\n",
        "        '%'\n",
        "    ) AS opportunity_share_pct,\n",
        "\n",
        "    RANK() OVER (\n",
        "        ORDER BY open_opportunity_count DESC\n",
        "    ) AS opportunity_rank\n",
        "\n",
        "FROM rep_opportunities\n",
        "CROSS JOIN total_open\n",
        "\n",
        "ORDER BY opportunity_rank;"
      ]
    }
  ],
